VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Add other Vite env variables here, for example:
# VITE_API_BASE_URL=https://api.example.com

# Hotels pages (/hotels): the key for the hotels data service. It only works from TravelMate's own
# websites. Set it in the hosting environment (not in the repo) before building.
VITE_HOTELS_API_KEY=
# Optional: defaults to https://grow.impt.io/hotels-api/v1
# VITE_HOTELS_API_BASE=

# Flights: "mock" serves recorded Amadeus test data (src/features/flights/mocks/README.md)
# so the new flight UI works without the backend. Leave unset (live) in production.
# VITE_FLIGHTS_API_MODE=mock
# Flights Extras step (paid bags). "on" once the backend sells bags.
# VITE_FLIGHTS_EXTRAS=on

# Products shown on the site. Off unless "on": a build with none of these is the
# hotels-only production site. Turn them on for development and the preview.
# VITE_FEATURE_STAYS=on
# VITE_FEATURE_TRANSFERS=on
# VITE_FEATURE_FLIGHTS=on
# VITE_FEATURE_APP_PROMO=on
