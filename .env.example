VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Add other Vite env variables here, for example:
# VITE_API_BASE_URL=https://api.example.com

# Hotels pages (/hotels): the key for the hotels data service. It only works from TravelMate's own
# websites. Set it in the hosting environment (not in the repo) before building.
VITE_HOTELS_API_KEY=
# Optional: defaults to https://grow.impt.io/hotels-api/v1
# VITE_HOTELS_API_BASE=
